# Express server port (Render sets this dynamically)
PORT=5000

# Supabase PostgreSQL Connection String
# IMPORTANT FOR RENDER:
# Do NOT use the Direct Connection (db.[PROJECT_REF].supabase.co) as it resolves ONLY to IPv6, which Render cannot route.
# Use the Supabase Session Pooler (port 5432) which provides IPv4 connectivity:
#
# Format:
# postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# Tokyo Region (ap-northeast-1) Example:
# postgresql://postgres.oyjmdtngezoqvgkqfhay:[YOUR_PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Note: If your password contains special characters (like @, #, $, %, &, :), they MUST be URL-encoded!
DATABASE_URL=your_supabase_postgresql_connection_string

# Optional: Connection pool sizing and timeouts
PG_MAX_CONNECTIONS=10
PG_CONNECTION_TIMEOUT_MS=15000

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,https://propertyse-v1.web.app,https://propertyse-v1.firebaseapp.com
